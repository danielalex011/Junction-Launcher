{
  "name": "junction-launcher",
  "version": "0.1.43",
  "description": "A Minecraft launcher that installs mods and modpacks from both Modrinth and CurseForge. No ads, no telemetry.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:quiet": "node --test --test-reporter=./tools/quiet-reporter.js test/*.test.js",
    "dist:win": "electron-builder --win",
    "screenshots": "node tools/screenshots.js",
    "deploy:dev": "node tools/deploy-dev.js",
    "vendor": "node tools/vendor.js",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg"
  },
  "author": "Daniel",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "marked": "^18.2.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "skinview3d": "^3.4.2"
  },
  "productName": "Junction",
  "build": {
    "appId": "dk.junction.launcher",
    "productName": "Junction",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "build-config.json",
      "!node_modules/sql.js/dist/!(sql-wasm.js|sql-wasm.wasm)",
      "!node_modules/sql.js/{documentation,examples,coverage}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "fileAssociations": [
      {
        "ext": "mrpack",
        "name": "Modrinth modpack",
        "description": "Modrinth modpack",
        "role": "Viewer"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "da"
    ],
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielalex011/Junction-Launcher"
  },
  "homepage": "https://github.com/danielalex011/Junction-Launcher"
}
